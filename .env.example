# Local development uses SQLite automatically when DATABASE_URL is unset.
# Vercel + Supabase: use the Transaction pooler connection string from Supabase > Connect.
# Example scheme: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Generate a random value with at least 32 characters. Set this in local .env and Vercel.
SESSION_SECRET_KEY=

# Vercel serves HTTPS; set this to true there. Local HTTP can leave it false.
COOKIE_SECURE=false
